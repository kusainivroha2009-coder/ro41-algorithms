using System;
using System.Text;

public static class TextTools
{
    // 1. Подсчет количества слов (лишние пробелы не учитываются)
    public static int CountWords(string s)
    {
        if (string.IsNullOrWhiteSpace(s))
            return 0;

        int wordCount = 0;
        bool inWord = false;

        for (int i = 0; i < s.Length; i++)
        {
            if (!char.IsWhiteSpace(s[i]))
            {
                if (!inWord)
                {
                    inWord = true;
                    wordCount++;
                }
            }
            else
            {
                inWord = false;
            }
        }

        return wordCount;
    }

    // 2. Проверка на палиндром (без учета регистра и пробелов)
    public static bool IsPalindrome(string s)
    {
        if (string.IsNullOrEmpty(s))
            return true;

        int left = 0;
        int right = s.Length - 1;

        while (left < right)
        {
            while (left < right && char.IsWhiteSpace(s[left]))
                left++;

            while (left < right && char.IsWhiteSpace(s[right]))
                right--;

            if (left < right)
            {
                // Сравнение символов без учета регистра
                if (char.ToLower(s[left]) != char.ToLower(s[right]))
                    return false;

                left++;
                right--;
            }
        }

        return true;
    }

    // 3. Формирование инициалов ("Ахметов Ерлан Серикұлы" -> "А. Е. С.")
    public static string Initials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            string.Empty;

        string trimmed = fullName.Trim();
        if (string.IsNullOrEmpty(trimmed))
            return string.Empty;

        StringBuilder sb = new StringBuilder();
        bool isNewWord = true;

        for (int i = 0; i < trimmed.Length; i++)
        {
            char c = trimmed[i];

            if (char.IsWhiteSpace(c))
            {
                isNewWord = true;
            }
            else if (isNewWord)
            {
                // Берем первую букву слова, переводим в верхний регистр и добавляем точку с пробелом
                sb.Append(char.ToUpper(c));
                sb.Append(". ");
                isNewWord = false;
            }
        }

        // Возвращаем строку без замыкающего пробела
        return sb.ToString().TrimEnd();
    }

    // 4. Повторение строки n раз с использованием StringBuilder
    public static string Repeat(string s, int n)
    {
        if (string.IsNullOrEmpty(s) || n <= 0)
            return string.Empty;

        StringBuilder sb = new StringBuilder(s.Length * n);
        for (int i = 0; i < n; i++)
        {
            sb.Append(s);
        }

        return sb.ToString();
    }
}

class Program
{
    static void Main()
    {
        Console.WriteLine("=== ТЕСТИРОВАНИЕ TEXT TOOLS ===\n");

        // Тест метода CountWords
        Console.WriteLine("--- CountWords Tests ---");
        TestCountWords("", 0);
        TestCountWords("    ", 0);
        TestCountWords(" a  b ", 2);
        TestCountWords("Ахметов Ерлан Серикұлы", 3);
        Console.WriteLine();

        // Тест метода IsPalindrome
        Console.WriteLine("--- IsPalindrome Tests ---");
        TestIsPalindrome("", true);
        TestIsPalindrome("    ", true);
        TestIsPalindrome("А роза упала на лапу Азора", true);
        TestIsPalindrome("Ахметов Ерлан", false);
        Console.WriteLine();

        // Тест метода Initials
        Console.WriteLine("--- Initials Tests ---");
        TestInitials("Ахметов Ерлан Серикұлы", "А. Е. С.");
        TestInitials("Иванов Иван", "И. И.");
        Console.WriteLine();

        // Тест метода Repeat
        Console.WriteLine("--- Repeat Tests ---");
        TestRepeat("abc", 3, "abcabcabc");
        TestRepeat("test", 0, "");
    }

    static void TestCountWords(string input, int expected)
    {
        int actual = TextTools.CountWords(input);
        string status = (actual == expected) ? "OK" : "FAIL";
        Console.WriteLine($"Input: \"{input}\" | Expected: {expected} | Actual: {actual} | [{status}]");
    }

    static void TestIsPalindrome(string input, bool expected)
    {
        bool actual = TextTools.IsPalindrome(input);
        string status = (actual == expected) ? "OK" : "FAIL";
        Console.WriteLine($"Input: \"{input}\" | Expected: {expected} | Actual: {actual} | [{status}]");
    }

    static void TestInitials(string input, string expected)
    {
        string actual = TextTools.Initials(input);
        string status = (actual == expected) ? "OK" : "FAIL";
        Console.WriteLine($"Input: \"{input}\" | Expected: \"{expected}\" | Actual: \"{actual}\" | [{status}]");
    }

    static void TestRepeat(string input, int n, string expected)
    {
        string actual = TextTools.Repeat(input, n);
        string status = (actual == expected) ? "OK" : "FAIL";
        Console.WriteLine($"Input: \"{input}\", n={n} | Expected: \"{expected}\" | Actual: \"{actual}\" | [{status}]");
    }
}
