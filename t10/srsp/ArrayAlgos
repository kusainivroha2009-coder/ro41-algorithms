using System;

public static class ArrayAlgos
{
    // 1. Проверка отсортированности массива
    public static bool IsSorted(int[] a)
    {
        if (a == null) return true;

        for (int index = 0; index < a.Length - 1; index++)
        {
            if (a[index] > a[index + 1])
                return false;
        }
        return true;
    }

    // 2. Сортировка пузырьком с подсчетом сравнений
    public static int BubbleSort(int[] a)
    {
        if (a == null || a.Length < 2) 
            return 0;

        int totalComparisons = 0;
        int len = a.Length;

        for (int pass = 0; pass < len - 1; pass++)
        {
            bool hasSwaps = false;

            for (int j = 0; j < len - 1 - pass; j++)
            {
                totalComparisons++;
                if (a[j] > a[j + 1])
                {
                    int temp = a[j];
                    a[j] = a[j + 1];
                    a[j + 1] = temp;
                    hasSwaps = true;
                }
            }

            if (!hasSwaps) break;
        }

        return totalComparisons;
    }

    // Поиск первого индекса элемента >= target
    private static int FindFirstIndex(int[] sortedA, int target)
    {
        int low = 0;
        int high = sortedA.Length - 1;
        int result = sortedA.Length;

        while (low <= high)
        {
            int mid = low + (high - low) / 2;
            if (sortedA[mid] >= target)
            {
                result = mid;
                high = mid - 1;
            }
            else
            {
                low = mid + 1;
            }
        }
        return result;
    }

    // Поиск первого индекса элемента > target
    private static int FindLastIndex(int[] sortedA, int target)
    {
        int low = 0;
        int high = sortedA.Length - 1;
        int result = sortedA.Length;

        while (low <= high)
        {
            int mid = low + (high - low) / 2;
            if (sortedA[mid] > target)
            {
                result = mid;
                high = mid - 1;
            }
            else
            {
                low = mid + 1;
            }
        }
        return result;
    }

    // 3. Подсчет вхождений через 2 бинарных поиска
    public static int CountOccurrences(int[] sortedA, int x)
    {
        if (sortedA == null || sortedA.Length == 0) 
            return 0;

        int firstIdx = FindFirstIndex(sortedA, x);
        int lastIdx = FindLastIndex(sortedA, x);

        return lastIdx - firstIdx;
    }
}

class Program
{
    static void Main()
    {
        // Тестирование BubbleSort
        int[][] testArrays = new int[][]
        {
            new int[] { },
            new int[] { 5 },
            new int[] { 1, 2, 3, 4, 5 },
            new int[] { 5, 4, 3, 2, 1 },
            new int[] { 3, 1, 3, 2, 3 }
        };

        Console.WriteLine("=== BUBBLE SORT TESTS ===");
        foreach (var original in testArrays)
        {
            int[] arr = (int[])original.Clone();
            Console.WriteLine($"Before: [{string.Join(", ", arr)}]");
            
            int comps = ArrayAlgos.BubbleSort(arr);
            bool sorted = ArrayAlgos.IsSorted(arr);
            
            Console.WriteLine($"After:  [{string.Join(", ", arr)}]");
            Console.WriteLine($"IsSorted = {sorted}, Comparisons = {comps}\n");
        }

        // Проверка на отсортированном массиве из 1000 элементов
        int[] thousandElements = new int[1000];
        for (int i = 0; i < thousandElements.Length; i++) 
            thousandElements[i] = i;

        int compsThousand = ArrayAlgos.BubbleSort(thousandElements);
        Console.WriteLine($"1000 items comps: {compsThousand} (Expected: 999)\n");

        // Тестирование CountOccurrences
        Console.WriteLine("=== COUNT OCCURRENCES TESTS ===");
        int[] data = { 1, 2, 2, 2, 5, 7 };
        int[] queries = { 2, 1, 7, 3, 9 };

        Console.WriteLine($"Array: [{string.Join(", ", data)}]\n");
        foreach (int val in queries)
        {
            int occ = ArrayAlgos.CountOccurrences(data, val);
            Console.WriteLine($"x = {val} -> occurrences: {occ}");
        }
    }
}
